# Auto-loaded by direnv on cd into this repo; run `direnv allow` once to
# enable. Requires the direnv shell hook in your rc.

# Load the devbox-declared environment (Python 3.12 + PyYAML for tools/).
# See https://www.jetify.com/docs/devbox/ide_configuration/direnv/
eval "$(devbox generate direnv --print-envrc)"

# Keep GitHub CLI creds project-local (./.gh, gitignored) instead of the
# shared ~/.config/gh.
export GH_CONFIG_DIR="$PWD/.gh"
